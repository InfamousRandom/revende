{
  "name": "revende",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "3bbdb431f6f94a3b82bc214701406b4e" }
  ],
  // Historial de ventas, catálogo y capturas de usado (Fase 3). Migraciones en migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revende-db",
      "database_id": "56e3ab54-e298-4e7a-a765-e578e7846b14",
      "migrations_dir": "migrations"
    }
  ],
  // Fotos de los artículos del inventario (Revende 2.0, Fase V2).
  "r2_buckets": [
    { "binding": "FOTOS_ARTICULOS", "bucket_name": "revende-fotos" }
  ],
  // Fotos temporales para Google Lens (lectura consistente desde cualquier región).
  "durable_objects": {
    "bindings": [{ "name": "FOTOS", "class_name": "FotoTemporal" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FotoTemporal"] }]
}
